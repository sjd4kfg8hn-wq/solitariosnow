:root {
    --cyan-glow: #00e7ff;
    --pink-glow: #ff4dff;
}

body {
    background-image: linear-gradient(to bottom, rgba(5, 7, 15, 0.75), rgba(10, 15, 30, 0.9)), url('/imagenes/solitario_table.jpg');
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    background-attachment: fixed;
}

/* Slots de cartas */
.card-slot, .tableau-column {
    min-height: 120px;
    border: 1px dashed rgba(0, 231, 255, 0.2);
    border-radius: 12px;
    transition: all 0.2s ease;
}

.tableau-column {
    border: none;
    position: relative;
    margin: 0 4px;
}

/* Diseño visual de Carta Cyberpunk / Alpina */
.card {
    width: 80px;
    height: 115px;
    border-radius: 12px;
    background: #0d1322;
    border: 2px solid var(--cyan-glow);
    box-shadow: 0 0 10px rgba(0, 231, 255, 0.3);
    color: white;
    font-family: 'Orbitron', sans-serif;
    position: absolute;
    cursor: pointer;
    user-select: none;
    transition: transform 0.15s ease, box-shadow 0.2s ease;
}

@media (min-width: 640px) {
    .card {
        width: 95px;
        height: 135px;
    }
    .card-slot {
        width: 95px;
        height: 135px;
    }
}

.card.red {
    border-color: var(--pink-glow);
    box-shadow: 0 0 10px rgba(255, 77, 255, 0.3);
    color: var(--pink-glow);
}

.card.black {
    border-color: var(--cyan-glow);
    color: var(--cyan-glow);
}

/* Dorso de la carta */
.card.face-down {
    background: linear-gradient(135deg, #09111e 0%, #170a2c 100%);
    border: 2px solid #3b82f6;
    box-shadow: 0 0 8px rgba(59, 130, 246, 0.4);
}

.card.face-down::after {
    content: "❄";
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-size: 1.8rem;
    color: rgba(0, 231, 255, 0.4);
}

/* Animaciones y selección limpia sin solapamientos en pilas */
.card.selected-root {
    z-index: 999 !important;
    transform: translateY(-8px);
    box-shadow: 0 0 25px var(--cyan-glow);
}

.card.red.selected-root {
    box-shadow: 0 0 25px var(--pink-glow);
}
